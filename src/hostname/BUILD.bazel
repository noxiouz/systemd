"""BUILD file for hostname tools."""

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "hostnamectl",
    srcs = ["hostnamectl.c"],
    copts = [
        "-include", "$(GENDIR)/bazel/config.h",
    ],
    deps = [
        "//bazel:config",
        "//src/shared:shared_static",
    ],
)
