# ==============================================================================
# Static library for internal use
# ==============================================================================

cc_library(
    name = "shared_static",
    srcs = SHARED_SRCS + [
        ":dns_type_from_name_inc",
        ":dns_type_to_name_inc",
        ":ethtool_link_mode_inc",
        ":ip_protocol_from_name_inc",
        ":ip_protocol_to_name_inc",
        ":syscall_list_inc",
    ],
    hdrs = glob(["*.h"]),
    copts = [
        "-fvisibility=default",
        # Standard defines for Linux
        "-D_GNU_SOURCE",
        "-D__SANE_USERSPACE_TYPES__",
        "-D_LARGEFILE64_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        # Include config.h for all source files
        "-include", "$(GENDIR)/bazel/config.h",
        # Include paths for generated headers
        "-I$(GENDIR)/src/version",
    ],
    includes = ["."],
    linkopts = [
        "-ldl",
        "-lm",
        "-lrt",
        "-lpthread",
    ],
    deps = [
        "//bazel:config",
        "//src/basic",
        "//src/include",
        "//src/libc:libc_wrapper",
        "//src/libsystemd:systemd_static",
        # Hermetic third-party dependencies
        "@util-linux//:libblkid",
        "@util-linux//:libmount",
        "@kmod//:libkmod",
    ],
)

# Alias for linking
alias(
    name = "shared",
    actual = ":shared_static",
)
