"""BUILD file for shared library - common code for systemd components."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/rules:gperf.bzl", "gperf_capture")
load("//bazel/rules:codegen.bzl", "generate_gperf_from_list", "python_codegen", "shell_codegen")
load("//bazel/rules:awk.bzl", "awk_codegen")

package(default_visibility = ["//visibility:public"])

exports_files([
    "libshared.sym",
    "generate-ip-protocol-list.sh",
    "generate-syscall-list.py",
    "generate-dns_type-gperf.py",
    "generate-dns_type-list.sed",
    "ethtool-link-mode.py",
    "ip-protocol-to-name.awk",
    "dns_type-to-name.awk",
])

# ==============================================================================
# Forward declaration headers (header-only, for breaking circular deps)
# ==============================================================================

cc_library(
    name = "shared_forward_hdrs",
    hdrs = ["shared-forward.h"],
    includes = ["."],
    deps = [
        "//src/libsystemd:systemd_static",  # For sd-forward.h
    ],
)

# Header-only library for internal network library (libsystemd-network)
# This avoids circular dependency: shared depends on systemd_static,
# but libsystemd-network needs shared headers without shared sources
cc_library(
    name = "shared_hdrs",
    hdrs = glob(["*.h"]),
    includes = ["."],
    deps = [
        "//src/basic",
        "//src/libsystemd:systemd_static",
    ],
)

# ==============================================================================
# Code Generation: IP Protocol list
# ==============================================================================

shell_codegen(
    name = "ip_protocol_list_txt",
    script = "generate-ip-protocol-list.sh",
    out = "ip-protocol-list.txt",
)

generate_gperf_from_list(
    name = "ip_protocol_from_name_gperf",
    script = "//tools:generate-gperfs.py",
    list_file = ":ip_protocol_list_txt",
    out = "ip-protocol-from-name.gperf",
    name_arg = "ip_protocol",
    prefix = "IPPROTO_",
    includes = ["<netinet/in.h>"],
)

gperf_capture(
    name = "ip_protocol_from_name_inc",
    src = ":ip_protocol_from_name_gperf",
    out = "ip-protocol-from-name.inc",
    language = "ANSI-C",
    struct_type = True,
    ignore_case = True,
    lookup_function_name = "lookup_ip_protocol",
    hash_function_name = "hash_ip_protocol_name",
    pic = True,
    readonly_tables = True,
)

awk_codegen(
    name = "ip_protocol_to_name_inc",
    script = "ip-protocol-to-name.awk",
    srcs = [":ip_protocol_list_txt"],
    out = "ip-protocol-to-name.inc",
)

# ==============================================================================
# Code Generation: Syscall list
# ==============================================================================

python_codegen(
    name = "syscall_list_inc",
    script = "generate-syscall-list.py",
    srcs = ["//src/include/override/sys:syscall-list.txt"],
    out = "syscall-list.inc",
    args = [],
    inputs_as_args = True,
    capture = True,
)

# ==============================================================================
# Code Generation: DNS type list
# ==============================================================================

genrule(
    name = "dns_type_list_txt",
    srcs = ["dns-type.h"],
    outs = ["dns_type-list.txt"],
    cmd = "sed -n -r -f $(location generate-dns_type-list.sed) $(location dns-type.h) > $@",
    tools = ["generate-dns_type-list.sed"],
)

python_codegen(
    name = "dns_type_from_name_gperf",
    script = "generate-dns_type-gperf.py",
    srcs = [":dns_type_list_txt"],
    out = "dns_type-from-name.gperf",
    args = [
        "dns_type",
        "DNS_TYPE_",
    ],
    inputs_as_args = True,
    capture = True,
)

gperf_capture(
    name = "dns_type_from_name_inc",
    src = ":dns_type_from_name_gperf",
    out = "dns_type-from-name.inc",
    language = "ANSI-C",
    struct_type = True,
    ignore_case = True,
    lookup_function_name = "lookup_dns_type",
    hash_function_name = "hash_dns_type_name",
    pic = True,
    readonly_tables = True,
)

awk_codegen(
    name = "dns_type_to_name_inc",
    script = "dns_type-to-name.awk",
    srcs = [":dns_type_list_txt"],
    out = "dns_type-to-name.inc",
)

# ==============================================================================
# Code Generation: Ethtool link mode
# ==============================================================================

python_codegen(
    name = "ethtool_link_mode_inc",
    script = "ethtool-link-mode.py",
    out = "ethtool-link-mode.inc",
    args = ["--header", "cpp"],
    capture = True,
)

