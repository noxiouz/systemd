# ==============================================================================
# Code Generation: Filesystem sets
# ==============================================================================

python_codegen(
    name = "filesystem_sets_c",
    script = "filesystem-sets.py",
    out = "filesystem-sets.c",
    args = [
        "fs-type-to-string",
        "filesystem-sets",
        "fs-in-group",
    ],
    capture = True,
)

python_codegen(
    name = "filesystems_gperf_gperf",
    script = "filesystem-sets.py",
    out = "filesystems-gperf.gperf",
    args = ["gperf"],
    capture = True,
)

gperf(
    name = "filesystems_gperf_h",
    src = ":filesystems_gperf_gperf",
    out = "filesystems-gperf.h",
)

# ==============================================================================
# Generated headers collection
# ==============================================================================

filegroup(
    name = "generated_gperf_headers",
    srcs = [
        ":af_from_name_inc",
        ":af_to_name_inc",
        ":arphrd_from_name_inc",
        ":arphrd_to_name_inc",
        ":capability_from_name_inc",
        ":capability_to_name_inc",
        ":errno_from_name_inc",
        ":errno_to_name_inc",
        ":filesystem_sets_c",
        ":filesystems_gperf_h",
    ],
)

