"""BUILD file for basic library - core utilities used everywhere."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/rules:gperf.bzl", "gperf", "gperf_capture")
load("//bazel/rules:codegen.bzl", "generate_gperf_from_list", "python_codegen", "shell_codegen")
load("//bazel/rules:awk.bzl", "awk_codegen")

package(default_visibility = ["//visibility:public"])

# Export scripts for use by other targets
exports_files([
    "generate-af-list.sh",
    "generate-arphrd-list.sh",
    "generate-capability-list.sh",
    "generate-errno-list.sh",
    "af-to-name.awk",
    "arphrd-to-name.awk",
    "capability-to-name.awk",
    "errno-to-name.awk",
    "filesystem-sets.py",
])

# ==============================================================================
# Code Generation: AF (Address Family) constants
# ==============================================================================

shell_codegen(
    name = "af_list_txt",
    script = "generate-af-list.sh",
    out = "af-list.txt",
)

generate_gperf_from_list(
    name = "af_from_name_gperf",
    script = "//tools:generate-gperfs.py",
    list_file = ":af_list_txt",
    out = "af-from-name.gperf",
    name_arg = "af",
    prefix = "",
    includes = ["<sys/socket.h>"],
)

gperf_capture(
    name = "af_from_name_inc",
    src = ":af_from_name_gperf",
    out = "af-from-name.inc",
    language = "ANSI-C",
    struct_type = True,
    ignore_case = True,
    lookup_function_name = "lookup_af",
    hash_function_name = "hash_af_name",
    pic = True,
    readonly_tables = True,
)

awk_codegen(
    name = "af_to_name_inc",
    script = "af-to-name.awk",
    srcs = [":af_list_txt"],
    out = "af-to-name.inc",
)

