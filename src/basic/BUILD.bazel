    hdrs = glob(["*.h"]) + [
        "//src/fundamental:fundamental_hdrs",
        "//src/version:version_h",
    ],
    copts = [
        "-fvisibility=default",
        # Standard defines for Linux
        "-D_GNU_SOURCE",
        "-D__SANE_USERSPACE_TYPES__",
