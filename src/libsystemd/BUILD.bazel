    SD_JOURNAL_SRCS +
    SD_ID128_SRCS +
    SD_DAEMON_SRCS +
    SD_EVENT_SRCS +
    SD_BUS_SRCS +
    SD_DEVICE_SRCS +
    SD_LOGIN_SRCS +
    SD_JSON_SRCS +
    SD_VARLINK_SRCS +
    SD_PATH_SRCS +
    SD_NETLINK_SRCS +
    SD_NETWORK_SRCS +
    SD_HWDB_SRCS +
    SD_RESOLVE_SRCS
)

# ==============================================================================
# Static library for internal use
# ==============================================================================

cc_library(
    name = "systemd_static",
    srcs = ALL_LIBSYSTEMD_SRCS + [
        ":audit_type_to_name_inc",
    ],
    hdrs = glob(
        [
            "sd-bus/*.h",
            "sd-common/*.h",
            "sd-device/*.h",
            "sd-event/*.h",
            "sd-hwdb/*.h",
            "sd-id128/*.h",
            "sd-journal/*.h",
            "sd-json/*.h",
            "sd-netlink/*.h",
            "sd-network/*.h",
            "sd-path/*.h",
            "sd-resolve/*.h",
            "sd-varlink/*.h",
        ],
        allow_empty = False,
    ) + [
        "//src/version:version_h",
    ],
    copts = [
        "-fvisibility=default",
        # Standard defines for Linux
        "-D_GNU_SOURCE",
        "-D__SANE_USERSPACE_TYPES__",
        "-D_LARGEFILE64_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        # Include config.h for all source files
        "-include", "$(GENDIR)/bazel/config.h",
        # Include paths for generated headers
        "-I$(GENDIR)/src/version",
    ],
    includes = [
        ".",
        "sd-bus",
        "sd-common",
        "sd-device",
        "sd-event",
        "sd-hwdb",
        "sd-id128",
        "sd-journal",
        "sd-json",
        "sd-netlink",
        "sd-network",
        "sd-path",
        "sd-resolve",
        "sd-varlink",
    ],
    linkopts = [
        "-lrt",
        "-lpthread",
        "-lm",
    ],
    deps = [
        "//bazel:config",
        "//src/basic",
        "//src/include",
        "//src/libc:libc_wrapper",
    ],
)

# ==============================================================================
# Shared library (libsystemd.so)
# ==============================================================================

cc_shared_library(
    name = "systemd",
    additional_linker_inputs = ["libsystemd.sym"],
    exports_filter = [
        "//src/libsystemd:systemd_static",
        "//src/basic:basic",
    ],
    shared_lib_name = "libsystemd.so.0",
    user_link_flags = [
        "-Wl,--version-script=$(location libsystemd.sym)",
        "-Wl,-z,nodelete",
        "-Wl,-soname,libsystemd.so.0",
    ],
    deps = [
        ":systemd_static",
    ],
)

# Alias for convenience
alias(
    name = "libsystemd",
    actual = ":systemd",
)
