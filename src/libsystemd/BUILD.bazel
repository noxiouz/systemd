"""BUILD file for libsystemd - the public systemd library."""

load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("//bazel/rules:codegen.bzl", "shell_codegen")
load("//bazel/rules:awk.bzl", "awk_codegen")

package(default_visibility = ["//visibility:public"])

exports_files([
    "libsystemd.sym",
    "libsystemd.pc.in",
])

# ==============================================================================
# Code Generation: Audit type list
# ==============================================================================

shell_codegen(
    name = "audit_type_list_txt",
    script = "sd-journal/generate-audit_type-list.sh",
    out = "audit_type-list.txt",
)

awk_codegen(
    name = "audit_type_to_name_inc",
    script = "sd-journal/audit_type-to-name.awk",
    srcs = [":audit_type_list_txt"],
    out = "audit_type-to-name.inc",
)

# ==============================================================================
# Source file lists by component
# ==============================================================================

