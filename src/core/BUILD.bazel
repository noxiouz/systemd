"""BUILD file for systemd core - PID 1 service manager."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//bazel/rules:gperf.bzl", "gperf")
load("//bazel/rules:awk.bzl", "awk_codegen")
load("//bazel/rules:jinja2.bzl", "jinja2_template")

package(default_visibility = ["//visibility:public"])

exports_files([
    "load-fragment-gperf.gperf.in",
    "load-fragment-gperf-nulstr.awk",
])

# ==============================================================================
# Code Generation: load-fragment gperf
# ==============================================================================

jinja2_template(
    name = "load_fragment_gperf_gperf",
    template = "load-fragment-gperf.gperf.in",
    out = "load-fragment-gperf.gperf",
    config_h = "//bazel:config_h_gen",
)

gperf(
    name = "load_fragment_gperf_c",
    src = ":load_fragment_gperf_gperf",
    out = "load-fragment-gperf.c",
)

awk_codegen(
    name = "load_fragment_gperf_nulstr_c",
    script = "load-fragment-gperf-nulstr.awk",
    srcs = [":load_fragment_gperf_gperf"],
    out = "load-fragment-gperf-nulstr.c",
)

# ==============================================================================
# BPF delegate configs (stub since BPF_FRAMEWORK=0)
# ==============================================================================

genrule(
    name = "bpf_delegate_configs_inc",
    outs = ["bpf-delegate-configs.inc"],
    cmd = """cat > $@ << 'EOF'
/* Stub - BPF_FRAMEWORK disabled */
/* Generated empty tables for bpf_delegate_* lookups */

static const char* const bpf_delegate_cmd_table[] = {
};

static const char* const bpf_delegate_map_type_table[] = {
};

static const char* const bpf_delegate_prog_type_table[] = {
};

static const char* const bpf_delegate_attach_type_table[] = {
};
EOF
""",
)

