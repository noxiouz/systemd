# ==============================================================================
# Core static library
# ==============================================================================

cc_library(
    name = "core_static",
    srcs = LIBCORE_SRCS + [
        ":load_fragment_gperf_c",
        ":load_fragment_gperf_nulstr_c",
        ":bpf_delegate_configs_inc",
    ],
    hdrs = glob(["*.h"]),
    copts = [
        "-fvisibility=default",
        "-D_GNU_SOURCE",
        "-D__SANE_USERSPACE_TYPES__",
        "-D_LARGEFILE64_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-include", "$(GENDIR)/bazel/config.h",
        "-I$(GENDIR)/src/version",
        "-I$(GENDIR)/src/core",
    ],
    includes = ["."],
    linkopts = [
        "-ldl",
        "-lm",
        "-lrt",
        "-lpthread",
        "-lcap",
    ],
    deps = [
        "//bazel:config",
        "//src/shared:shared_static",
    ],
)

# ==============================================================================
# systemd (PID 1) binary
# ==============================================================================

SYSTEMD_SRCS = [
    "main.c",
    "crash-handler.c",
    "clock-warp.c",
    "kmod-setup.c",
    "apparmor-setup.c",
    "ima-setup.c",
    "ipe-setup.c",
    "selinux-setup.c",
    "smack-setup.c",
    "efi-random.c",
]

cc_binary(
    name = "systemd",
    srcs = SYSTEMD_SRCS,
    copts = [
        "-fvisibility=default",
        "-D_GNU_SOURCE",
        "-D__SANE_USERSPACE_TYPES__",
        "-D_LARGEFILE64_SOURCE",
        "-D_FILE_OFFSET_BITS=64",
        "-include", "$(GENDIR)/bazel/config.h",
        "-I$(GENDIR)/src/version",
    ],
    linkopts = [
        "-ldl",
        "-lm",
        "-lrt",
        "-lpthread",
        "-lcap",
    ],
    deps = [
        "//bazel:config",
        ":core_static",
        "//src/shared:shared_static",
    ],
)

# ==============================================================================
# systemd-executor binary
# ==============================================================================

SYSTEMD_EXECUTOR_SRCS = [
    "executor.c",
    "exec-invoke.c",
]

cc_binary(
    name = "systemd-executor",
    srcs = SYSTEMD_EXECUTOR_SRCS,
    linkopts = [
        "-ldl",
        "-lm",
        "-lrt",
        "-lpthread",
        "-lcap",
    ],
    deps = [
        ":core_static",
        "//src/shared:shared_static",
    ],
)
