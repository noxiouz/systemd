"""BUILD file for systemd unit tests."""

load("@rules_cc//cc:defs.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Common test configuration
# ==============================================================================

TEST_COPTS = [
    "-include", "$(GENDIR)/bazel/config.h",
    "-I$(GENDIR)/src/version",
]

TEST_DEPS = [
    "//bazel:config",
    "//src/shared:shared_static",
]

# ==============================================================================
# Simple tests - standalone test files that link against shared library
# These test basic/shared utilities
# ==============================================================================

