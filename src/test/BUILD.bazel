[cc_test(
    name = test_name,
    srcs = [test_name + ".c", "//src/version:version_h"],
    copts = TEST_COPTS,
    deps = TEST_DEPS,
) for test_name in SIMPLE_TESTS]

# Note: test-hashmap-plain and test-hashmap-ordered require special compilation
