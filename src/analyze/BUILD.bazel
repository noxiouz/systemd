"""BUILD file for systemd-analyze."""

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

ANALYZE_SRCS = [
    "analyze.c",
    "analyze-architectures.c",
    "analyze-blame.c",
    "analyze-calendar.c",
    "analyze-capability.c",
    "analyze-cat-config.c",
    "analyze-chid.c",
    "analyze-compare-versions.c",
    "analyze-condition.c",
    "analyze-critical-chain.c",
    "analyze-dlopen-metadata.c",
    "analyze-dot.c",
    "analyze-dump.c",
    "analyze-exit-status.c",
    "analyze-fdstore.c",
    "analyze-filesystems.c",
    "analyze-has-tpm2.c",
    "analyze-image-policy.c",
    "analyze-inspect-elf.c",
    "analyze-log-control.c",
    "analyze-malloc.c",
    "analyze-nvpcrs.c",
    "analyze-pcrs.c",
    "analyze-plot.c",
    "analyze-security.c",
    "analyze-service-watchdogs.c",
    "analyze-smbios11.c",
    "analyze-srk.c",
    "analyze-syscall-filter.c",
    "analyze-time.c",
    "analyze-time-data.c",
    "analyze-timespan.c",
    "analyze-timestamp.c",
    "analyze-unit-files.c",
    "analyze-unit-gdb.c",
    "analyze-unit-paths.c",
    "analyze-unit-shell.c",
    "analyze-verify.c",
    "analyze-verify-util.c",
]

cc_binary(
    name = "systemd-analyze",
    srcs = ANALYZE_SRCS + glob(["*.h"]) + ["//src/version:version_h"],
    copts = [
        "-include", "$(GENDIR)/bazel/config.h",
        "-I$(GENDIR)/src/core",
        "-I$(GENDIR)/src/version",
    ],
    deps = [
        "//bazel:config",
        "//src/core:core_static",
        "//src/shared:shared_static",
    ],
)
